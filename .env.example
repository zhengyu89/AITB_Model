# For docker production
APP_ENV=production
APP_PORT=8000

# Shared secret for this vision service. Callers must send it as the X-API-KEY header.
# Reference the same value from the main FastAPI backend (AI-Travel-Buddy) vision client config.
VISION_SERVICE_API_KEY=

EMBEDDING_MODEL_NAME=facebook/dinov2-large

# POST /api/v1/embeddings — must match the model name AI-Travel-Buddy sends in
# its request body, or the request is rejected with 400.
TEXT_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
TEXT_EMBEDDING_MAX_BATCH=128

QDRANT_URL=http://host.docker.internal:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=malaysia_landmarks

# GPS re-ranking (soft prior; tune on a labelled set)
GEO_MAX_WEIGHT=0.08
GEO_PRIOR_DISTANCE_M=8000
GEO_REORDER_WINDOW=0.04

HF_TOKEN=  # Optional, it would be better if it were available.

# For local development
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_RELOAD=true
UVICORN_LOG_LEVEL=info
