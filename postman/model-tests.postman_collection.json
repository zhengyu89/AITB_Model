{
  "info": {
    "name": "Malaysia Vision \u2014 Model Smoke Tests",
    "description": "Checks model startup, both classifier heads, DINOv2 embedding metadata, Qdrant retrieval consistency, multipart uploads, and input validation. Run in order. Synthetic fixture proves execution, not accuracy. No standalone embedding endpoint exists; embedding checks use the prediction pipeline. Set api_key if API_KEY is enabled.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "",
      "type": "string"
    },
    {
      "key": "topk",
      "value": "5",
      "type": "string"
    },
    {
      "key": "expected_embedding_model",
      "value": "facebook/dinov2-large",
      "type": "string"
    },
    {
      "key": "expected_embedding_dim",
      "value": "1024",
      "type": "string"
    },
    {
      "key": "image_base64",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Health \u2014 models preloaded",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{api_key}}",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/health",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Healthy\", () => pm.expect(pm.response.json().status).to.equal(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Base64 \u2014 image classifiers + embedding",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{api_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/v1/predict/",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"image_base64\": \"{{image_base64}}\",\n  \"topk\": {{topk}},\n  \"include_classification\": true,\n  \"include_debug\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test(\"Prediction response is valid\", () => {",
              "    pm.expect(data.status).to.be.oneOf([\"accept\", \"tentative\", \"reject\"]);",
              "    pm.expect(data.retrieval_scope).to.equal(\"global\");",
              "    pm.expect(data.candidates).to.be.an(\"array\");",
              "    pm.expect(data.candidates.length).to.be.at.most(Number(pm.variables.get(\"topk\")));",
              "    data.candidates.forEach(c => {",
              "        pm.expect(Number.isFinite(c.similarity)).to.equal(true);",
              "        pm.expect(c.reference_hits).to.be.at.least(1);",
              "    });",
              "    if (data.status === \"reject\") pm.expect(data.final_match).to.equal(null);",
              "    else pm.expect(data.final_match).to.be.an(\"object\");",
              "});",
              "pm.test(\"Embedding model ran with expected dimensions\", () => {",
              "    pm.expect(data.debug).to.be.an(\"object\");",
              "    pm.expect(data.debug.embedding_model).to.equal(pm.variables.get(\"expected_embedding_model\"));",
              "    pm.expect(data.debug.embedding_dim).to.equal(Number(pm.variables.get(\"expected_embedding_dim\")));",
              "    pm.expect(data.debug.device).to.be.oneOf([\"cpu\", \"cuda\"]);",
              "});",
              "pm.test(\"Qdrant contains reference candidates\", () => {",
              "    pm.expect(data.candidates.length, \"Ingest reference images into the configured Qdrant collection\").to.be.above(0);",
              "});",
              "pm.test(\"Both image classifier heads ran\", () => {",
              "    pm.expect(data.classification).to.be.an(\"object\");",
              "    [\"attraction_top1\", \"food_top1\"].forEach(key => {",
              "        const result = data.classification[key];",
              "        pm.expect(result, key).to.be.an(\"object\");",
              "        pm.expect(result.class_path).to.be.a(\"string\").and.not.empty;",
              "        pm.expect(Number.isFinite(result.probability)).to.equal(true);",
              "        pm.expect(result.probability).to.be.within(0, 1);",
              "    });",
              "});",
              "pm.collectionVariables.set(\"baseline_prediction\", JSON.stringify({image: pm.variables.get(\"image_base64\"), topk: pm.variables.get(\"topk\"), candidates: data.candidates}));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Base64 \u2014 embedding retrieval without classification",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{api_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/v1/predict/",
        "description": "Uses the same image as request 02. Run in order against unchanged reference data. A 500 can indicate Qdrant failure even when the embedding model works.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"image_base64\": \"{{image_base64}}\",\n  \"topk\": {{topk}},\n  \"include_classification\": false,\n  \"include_debug\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test(\"Prediction response is valid\", () => {",
              "    pm.expect(data.status).to.be.oneOf([\"accept\", \"tentative\", \"reject\"]);",
              "    pm.expect(data.retrieval_scope).to.equal(\"global\");",
              "    pm.expect(data.candidates).to.be.an(\"array\");",
              "    pm.expect(data.candidates.length).to.be.at.most(Number(pm.variables.get(\"topk\")));",
              "    data.candidates.forEach(c => {",
              "        pm.expect(Number.isFinite(c.similarity)).to.equal(true);",
              "        pm.expect(c.reference_hits).to.be.at.least(1);",
              "    });",
              "    if (data.status === \"reject\") pm.expect(data.final_match).to.equal(null);",
              "    else pm.expect(data.final_match).to.be.an(\"object\");",
              "});",
              "pm.test(\"Embedding model ran with expected dimensions\", () => {",
              "    pm.expect(data.debug).to.be.an(\"object\");",
              "    pm.expect(data.debug.embedding_model).to.equal(pm.variables.get(\"expected_embedding_model\"));",
              "    pm.expect(data.debug.embedding_dim).to.equal(Number(pm.variables.get(\"expected_embedding_dim\")));",
              "    pm.expect(data.debug.device).to.be.oneOf([\"cpu\", \"cuda\"]);",
              "});",
              "pm.test(\"Qdrant contains reference candidates\", () => {",
              "    pm.expect(data.candidates.length, \"Ingest reference images into the configured Qdrant collection\").to.be.above(0);",
              "});",
              "pm.test(\"Classification disabled\", () => pm.expect(data.classification).to.equal(null));",
              "pm.test(\"Retrieval matches the same image with classification enabled\", () => {",
              "    const saved = pm.collectionVariables.get(\"baseline_prediction\");",
              "    pm.expect(saved, \"Run request 02 before request 03\").to.be.a(\"string\");",
              "    const baseline = JSON.parse(saved);",
              "    pm.expect(baseline.image).to.equal(pm.variables.get(\"image_base64\"));",
              "    pm.expect(baseline.topk).to.equal(pm.variables.get(\"topk\"));",
              "    pm.expect(data.candidates.length).to.equal(baseline.candidates.length);",
              "    data.candidates.forEach((candidate, i) => {",
              "        pm.expect(candidate.class_path).to.equal(baseline.candidates[i].class_path);",
              "        pm.expect(candidate.similarity).to.be.closeTo(baseline.candidates[i].similarity, 0.00001);",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Upload \u2014 image classifiers + embedding",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{api_key}}",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/v1/predict/upload?topk={{topk}}&include_classification=true&include_debug=true",
        "description": "Select a local JPG/PNG/WebP in Body > form-data > file. The supplied image is synthetic and only checks execution. Let Postman set the multipart Content-Type.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "postman/smoke-image.png"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test(\"Prediction response is valid\", () => {",
              "    pm.expect(data.status).to.be.oneOf([\"accept\", \"tentative\", \"reject\"]);",
              "    pm.expect(data.retrieval_scope).to.equal(\"global\");",
              "    pm.expect(data.candidates).to.be.an(\"array\");",
              "    pm.expect(data.candidates.length).to.be.at.most(Number(pm.variables.get(\"topk\")));",
              "    data.candidates.forEach(c => {",
              "        pm.expect(Number.isFinite(c.similarity)).to.equal(true);",
              "        pm.expect(c.reference_hits).to.be.at.least(1);",
              "    });",
              "    if (data.status === \"reject\") pm.expect(data.final_match).to.equal(null);",
              "    else pm.expect(data.final_match).to.be.an(\"object\");",
              "});",
              "pm.test(\"Embedding model ran with expected dimensions\", () => {",
              "    pm.expect(data.debug).to.be.an(\"object\");",
              "    pm.expect(data.debug.embedding_model).to.equal(pm.variables.get(\"expected_embedding_model\"));",
              "    pm.expect(data.debug.embedding_dim).to.equal(Number(pm.variables.get(\"expected_embedding_dim\")));",
              "    pm.expect(data.debug.device).to.be.oneOf([\"cpu\", \"cuda\"]);",
              "});",
              "pm.test(\"Qdrant contains reference candidates\", () => {",
              "    pm.expect(data.candidates.length, \"Ingest reference images into the configured Qdrant collection\").to.be.above(0);",
              "});",
              "pm.test(\"Both image classifier heads ran\", () => {",
              "    pm.expect(data.classification).to.be.an(\"object\");",
              "    [\"attraction_top1\", \"food_top1\"].forEach(key => {",
              "        const result = data.classification[key];",
              "        pm.expect(result, key).to.be.an(\"object\");",
              "        pm.expect(result.class_path).to.be.a(\"string\").and.not.empty;",
              "        pm.expect(Number.isFinite(result.probability)).to.equal(true);",
              "        pm.expect(result.probability).to.be.within(0, 1);",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Invalid base64 \u2014 rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{api_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/v1/predict/",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"image_base64\": \"not-an-image\",\n  \"topk\": {{topk}},\n  \"include_classification\": true,\n  \"include_debug\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Invalid image returns 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Error detail present\", () => pm.expect(pm.response.json().detail).to.include(\"Invalid image_base64\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Invalid topk \u2014 rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{api_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/v1/predict/",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"image_base64\": \"{{image_base64}}\",\n  \"topk\": 0,\n  \"include_classification\": true,\n  \"include_debug\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Invalid topk returns 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"topk validation error\", () => pm.expect(pm.response.json().detail.some(e => e.loc.includes(\"topk\"))).to.equal(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Missing upload \u2014 rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{api_key}}",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/v1/predict/upload",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Missing file returns 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"file validation error\", () => pm.expect(pm.response.json().detail.some(e => e.loc.includes(\"file\"))).to.equal(true));"
            ]
          }
        }
      ]
    }
  ]
}
